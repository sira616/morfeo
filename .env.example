# Copia a .env.local (que no se versiona) y descomenta lo que necesites.

# --- Desarrollo: a dónde van las peticiones /api ---
# Sin esta variable, `npm run dev` levanta el servidor de mocks (MSW) y trabaja sin
# backend. Con ella, el proxy de Vite apunta al backend real y los mocks no arrancan.
# Es la forma recomendada de conectar los dos: misma URL de origen, sin CORS.
# VITE_API_TARGET=http://127.0.0.1:8000

# --- Producción: URL absoluta de la API ---
# Solo para el build. Al ser otro origen, la URL del frontend tiene que estar en
# ALLOWED_ORIGINS del backend o el navegador bloqueará las respuestas.
# Vacío = mismo origen (y en preview/e2e activa los mocks).
VITE_API_BASE_URL=

# --- Mocks en un build ---
# Solo para el e2e y para enseñar la interfaz sin backend. En un despliegue real se
# deja sin definir: si se activa, la app enseña datos inventados sin avisar de nada.
# VITE_ENABLE_MOCKS=true
