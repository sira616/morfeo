# Copia este fichero a .env y rellena lo que necesites. .env nunca se commitea.

# --- Entorno ---
# "development" habilita /docs. Por defecto es "production", que es el valor seguro.
ENVIRONMENT=development

# --- Base de datos ---
# SQLite basta para una app personal. Para Postgres:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/morfeo
DATABASE_URL=sqlite:///./morfeo.db

# --- Autenticación local ---
# Sin JWT_SECRET el backend no arranca: generarlo al vuelo cerraría la sesión de todo
# el mundo en cada reinicio. Generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=43200

# Cuentas con acceso a /dev, por nombre de usuario. El rol nunca llega del cliente.
ADMIN_USERNAMES=[]

# --- SMTP (códigos de confirmación de email) ---
# Sin SMTP_HOST el código se escribe en la consola del servidor, que en una app
# doméstica es preferible a no poder verificar un email nunca.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=morfeo@localhost

# --- LLM ---
# "cloud" = Claude; "local" = Ollama. Son datos de sueño y de estado de ánimo:
# el modo local existe para quien no quiera mandarlos fuera de su máquina.
LLM_PROVIDER=cloud
ANTHROPIC_API_KEY=
LLM_CLOUD_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Wearable ---
# Personal Access Token de https://cloud.ouraring.com/personal-access-tokens
# Los demás relojes entran por POST /api/sleep/import.
OURA_ACCESS_TOKEN=

# --- Servir el frontend desde el propio backend ---
# Ruta al build (npm run build en morfeo-frontend). Vacio = solo API, que es lo que
# se quiere en desarrollo, donde el frontend lo sirve Vite.
FRONTEND_DIST=

# --- Red ---
ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
