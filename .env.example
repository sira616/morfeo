# Copia este fichero a .env y rellena lo que necesites. .env nunca se commitea.

# --- Entorno ---
# "development" habilita /docs. Por defecto es "production", que es el valor seguro.
ENVIRONMENT=development

# --- Base de datos ---
# SQLite basta para una app personal. Para Postgres:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/morfeo
DATABASE_URL=sqlite:///./morfeo.db

# --- Auth ---
# Con LOCAL_DEV_AUTH=true no hacen falta las claves de Supabase, pero la
# autenticación NO es real: cualquier email y contraseña crean cuenta.
# El backend se niega a arrancar si esto se combina con ENVIRONMENT=production.
LOCAL_DEV_AUTH=true

# Dashboard de Supabase -> Settings -> API. No cruces la anon con la service_role:
# la service_role salta las políticas RLS y el arranque falla si son iguales.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# "cloud" = Claude; "local" = Ollama. Son datos de sueño y de estado de ánimo:
# el modo local existe para quien no quiera mandarlos fuera de su máquina.
LLM_PROVIDER=cloud
ANTHROPIC_API_KEY=
LLM_CLOUD_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Wearable ---
# Personal Access Token de https://cloud.ouraring.com/personal-access-tokens
# Los demás relojes entran por POST /api/sleep/import.
OURA_ACCESS_TOKEN=

# --- Servir el frontend desde el propio backend ---
# Ruta al build (npm run build en morfeo-frontend). Vacio = solo API, que es lo que
# se quiere en desarrollo, donde el frontend lo sirve Vite.
FRONTEND_DIST=

# --- Panel de /dev ---
# Cuentas con acceso. El rol no llega nunca del cliente: sale de aqui.
ADMIN_EMAILS=[]

# --- Red ---
ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
